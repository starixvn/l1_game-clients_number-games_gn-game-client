// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`UserInfo render With isLobby = false should match the snapshot 1`] = `
<div>
  <div
    class="user  "
  >
    <div
      class="info"
    >
      <div
        class="user-name"
        data-testid="user-name"
        id="user-info_user-name"
      />
      <div
        class="balance"
        data-testid="balance"
      >
        <span
          class="balance-text"
          id="user-info_balance"
        >
          <span
            data-testid="amount"
          >
            1
          </span>
          <span>
             
          </span>
        </span>
        <img
          alt="icon-coin"
          class="img-fluid"
          data-nimg="1"
          decoding="async"
          height="11"
          loading="lazy"
          src="/static/images/icons/icon-coin.svg"
          style="color: transparent;"
          width="10"
        />
      </div>
    </div>
    <div
      class="avatar "
      data-testid="avatar"
    >
      <img
        alt="Avatar"
        class="img-fluid circle"
        data-nimg="1"
        decoding="async"
        height="30"
        loading="lazy"
        src="/_next/image?url=%2Fstatic%2Fimages%2Favatar%2F1.jpg%3Fv%3D111&w=64&q=75"
        srcset="/_next/image?url=%2Fstatic%2Fimages%2Favatar%2F1.jpg%3Fv%3D111&w=32&q=75 1x, /_next/image?url=%2Fstatic%2Fimages%2Favatar%2F1.jpg%3Fv%3D111&w=64&q=75 2x"
        style="color: transparent;"
        width="30"
      />
    </div>
  </div>
</div>
`;

